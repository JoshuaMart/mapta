# --- LLM provider (pick ONE) ---------------------------------------------
# The agents use the OpenAI *Responses* API. Any endpoint implementing it works.
# The provider is inferred from the key you set; LLM_PROVIDER forces it.
# LLM_PROVIDER=openai | openrouter | custom

# Option A - OpenAI
OPENAI_API_KEY=sk-...

# Option B - OpenRouter (https://openrouter.ai/api/v1/responses)
# Leave OPENAI_API_KEY unset, or set LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=sk-or-v1-...
# MODEL=openai/gpt-5           # OpenRouter ids are vendor-prefixed
# OPENROUTER_APP_NAME=MAPTA    # sent as X-Title (OpenRouter rankings)
# OPENROUTER_SITE_URL=https://example.com   # sent as HTTP-Referer

# Option C - any other OpenAI-Responses-compatible gateway (LiteLLM, vLLM, ...)
# LLM_PROVIDER=custom
# LLM_API_KEY=...
# LLM_BASE_URL=https://my-gateway.example.com/v1
# MODEL=my-model

# Reasoning effort: high | medium | low | none
# Use "none" for models that do not accept a reasoning field.
# REASONING_EFFORT=high

# Per-request metadata. On by default for OpenAI, off elsewhere because
# gateways may reject unknown fields.
# SEND_METADATA=0

# --- Sandbox (required for the sandbox/validator agents to do anything) ---
# "module:function" returning a sandbox object. The bundled Docker provider:
SANDBOX_FACTORY=sandbox_docker:create_sandbox
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_WORKDIR=/home/user
# SANDBOX_NETWORK=bridge
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PACKAGES=nmap sqlmap
# SANDBOX_PIP_PACKAGES=pwntools
# Set to 1 for images that already ship the tooling and a /home/user/.venv.
# SANDBOX_SKIP_BOOTSTRAP=0

# --- Optional ---
# MAX_ROUNDS=100
# OUTPUT_DIR=scan-results
# SYSTEM_PROMPT=...
# USER_PROMPT=... ({target_url} is substituted per target)
# SANDBOX_SYSTEM_PROMPT=...
# VALIDATOR_SYSTEM_PROMPT=...

# Slack reporting (send_slack_alert / send_slack_summary are no-ops without this)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_CHANNEL=#security-alerts

# Optional: directory of XBEN-*/README.md files, used by analyze_logs.py to
# label vulnerability types in the Sankey diagram.
# BENCHMARKS_DIR=/path/to/validation-benchmarks/benchmarks
