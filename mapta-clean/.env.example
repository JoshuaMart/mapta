# --- OpenRouter ------------------------------------------------------------
# MAPTA talks to OpenRouter's Chat Completions endpoint, which every model in
# the catalogue implements. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Any slug from https://openrouter.ai/models (anthropic/..., google/...,
# meta-llama/..., openai/..., ...). Default: openai/gpt-5
# MODEL=openai/gpt-5

# Output cap per answer. Leave unset for the provider's default; raise it if
# long tool-call arguments come back truncated.
# MAX_TOKENS=16000

# Reasoning effort: high | medium | low | none ("none" for models that reject it)
# REASONING_EFFORT=high

# Attribution, used by OpenRouter for its public rankings.
# OPENROUTER_APP_NAME=MAPTA
# OPENROUTER_SITE_URL=https://example.com

# Return the generation's cost alongside the token counts in the usage log.
# OPENROUTER_TRACK_COST=1

# Strict tool schemas. Turn off if the model you picked rejects them.
# OPENROUTER_STRICT_TOOLS=1

# Optional upstream routing preference, most preferred first.
# OPENROUTER_PROVIDER_ORDER=anthropic,google-vertex
# OPENROUTER_ALLOW_FALLBACKS=1

# Point at a proxy or a self-hosted OpenRouter-compatible gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Sandbox ---------------------------------------------------------------
# docker | none | module:function  (a third-party provider factory)
SANDBOX_PROVIDER=docker
# SANDBOX_IMAGE=python:3.14-slim
# SANDBOX_WORKDIR=/home/user
# SANDBOX_NETWORK=bridge
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=512
# SANDBOX_PACKAGES=nmap sqlmap
# SANDBOX_PIP_PACKAGES=pwntools
# SANDBOX_TIMEOUT=120          # default per-command timeout
# SANDBOX_MAX_TIMEOUT=900      # ceiling for a timeout the agent asks for
# Set to 1 for images that already ship the tooling and a $SANDBOX_WORKDIR/.venv
# SANDBOX_SKIP_BOOTSTRAP=0

# --- Scan ------------------------------------------------------------------
# MAX_ROUNDS=100
# MAX_CONCURRENCY=0          # 0 = scan every target at once
# OUTPUT_DIR=scan-results
# SYSTEM_PROMPT=...
# USER_PROMPT=...            # {target_url} is substituted per target
# SANDBOX_SYSTEM_PROMPT=...
# VALIDATOR_SYSTEM_PROMPT=...
# MAILBOX_ENABLED=1          # disposable mail.tm inboxes

# --- Telegram reporting (optional) -----------------------------------------
# Create a bot with @BotFather, then get the chat id by messaging the bot and
# reading https://api.telegram.org/bot<TOKEN>/getUpdates
# Without both values, send_telegram_alert / send_telegram_summary report
# themselves as unavailable instead of failing.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_MESSAGE_THREAD_ID=7     # forum-topic id, for supergroups with topics
# TELEGRAM_SILENT=0                # deliver without a notification sound
# TELEGRAM_API_ROOT=https://api.telegram.org
